# ============================================================
#  ASSETOWN — configuration du backend
#  Copier ce fichier en `.env` :  cp .env.example .env
#  Ne jamais committer `.env` (déjà présent dans .gitignore).
# ============================================================

# --- Écoute du serveur -------------------------------------
# 127.0.0.1 = accessible uniquement depuis cette machine.
# 0.0.0.0   = accessible depuis le réseau (obligatoire derrière
#             un tunnel Cloudflare, un VPS ou un conteneur).
PORT=4200
HOST=127.0.0.1

# URL PUBLIQUE utilisée dans les manifests, les liens de
# téléchargement et les e-mails de vérification.
# En production : HTTPS obligatoire (les launchers refusent
# le HTTP hors 127.0.0.1 / localhost).
PUBLIC_BASE_URL=http://127.0.0.1:4200

# true derrière nginx / Caddy / Cloudflare Tunnel : fait
# confiance à X-Forwarded-For pour l'IP réelle des joueurs.
TRUST_PROXY=true

# --- Sécurité ----------------------------------------------
# Secret HMAC des sessions et des liens signés.
# Vide = généré automatiquement dans apps/backend/storage/secret.key
# (à sauvegarder : le changer déconnecte tous les joueurs).
ASSETOWN_SECRET=

# Durées de vie des jetons, en secondes.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# --- Stockage ----------------------------------------------
# Vide = apps/backend/storage
ASSETOWN_DATA_DIR=

# --- Compte propriétaire initial ---------------------------
# Créé uniquement si aucun administrateur n'existe encore.
# Mot de passe vide = généré et écrit dans
# apps/backend/storage/initial-admin.txt
INITIAL_ADMIN_EMAIL=admin@assetown.fr
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=AssetownAdmin

# --- Serveur Minecraft par défaut --------------------------
# Utilisé pour l'état des serveurs et les nouveaux builds.
DEFAULT_SERVER_HOST=play.assetown.fr
DEFAULT_SERVER_PORT=25565

# --- E-mails (vérification, mot de passe oublié) ------------
# Sans SMTP, les e-mails sont écrits dans
# apps/backend/storage/mail-outbox/ (aucun envoi réel).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Assetown <no-reply@assetown.fr>"

# --- Webhooks Discord chiffrés -----------------------------
# Inscriptions, connexions (IP, user-agent) et tickets support.
# URL vide = webhooks désactivés.
# L'URL et la clé ne sortent jamais du serveur.
DISCORD_WEBHOOK_URL=
# Clé AES-256-GCM des charges sensibles.
# Vide = dérivée de ASSETOWN_SECRET.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_EVENTS=account.created,auth.login,support.report
# true = pseudo en clair dans l'embed ; tout le reste reste chiffré.
WEBHOOK_PLAINTEXT=true

# --- HTTPS direct (optionnel) ------------------------------
# Si l'API sert elle-même le TLS (sinon laisser vide et utiliser
# nginx, Caddy ou Cloudflare Tunnel devant).
HTTPS_KEY_FILE=
HTTPS_CERT_FILE=
