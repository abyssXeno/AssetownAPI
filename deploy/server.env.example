# Copier en `deploy/server.env` sur le serveur puis adapter.
# C'est le `.env` du backend ; les mots de passe et clés restent ici, jamais
# dans l'image ni dans le dépôt.

# --- Écoute (forcée par docker compose, rappel) -------------
PORT=4200
HOST=0.0.0.0

# URL publique stable = le site routeur (les clients ne voient que lui).
PUBLIC_BASE_URL=https://assetown-api-router-3e3dmn-preview.freebuff.site
TRUST_PROXY=true

# --- Sécurité ----------------------------------------------
# Vide : le secret est lu dans /data/secret.key (copié depuis le PC).
# Ne jamais le perdre : le changer déconnecte tous les joueurs.
ASSETOWN_SECRET=

# --- Compte propriétaire (utilisé seulement au premier démarrage) ---
INITIAL_ADMIN_EMAIL=admin@assetown.fr
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=AssetownAdmin

# --- Serveur Minecraft -------------------------------------
DEFAULT_SERVER_HOST=play.assetown.fr
DEFAULT_SERVER_PORT=25565

# --- E-mails (facultatif) ----------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Assetown <no-reply@assetown.fr>"

# --- Webhooks Discord chiffrés -----------------------------
DISCORD_WEBHOOK_URL=
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_EVENTS=account.created,auth.login,support.report
WEBHOOK_PLAINTEXT=true
