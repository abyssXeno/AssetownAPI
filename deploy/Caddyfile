# ASSETOWN — HTTPS automatique (Let's Encrypt) devant l'API.
# DOMAIN et ACME_EMAIL sont fournis par deploy/.env (docker compose).
#
# trusted_proxies : les plages Cloudflare sont les seules autorisées à
# fournir X-Forwarded-For. Le site routeur (Worker Cloudflare) y place
# l'IP réelle du joueur ; une requête directe sur ce domaine voit son
# IP remplacée par son adresse de socket, donc pas d'usurpation possible.

{
	email {$ACME_EMAIL}

	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers X-Forwarded-For CF-Connecting-IP
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Uploads de builds depuis le panneau admin (le backend accepte 256 Mo).
	request_body {
		max_size 300MB
	}

	reverse_proxy api:4200 {
		flush_interval -1
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}
}
